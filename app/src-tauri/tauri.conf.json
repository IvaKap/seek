{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seek",
  "version": "0.2.8",
  "identifier": "org.seek.unofficial",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Seek",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState",
          "radius": 10.0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Music",
    "copyright": "GPL-3.0-or-later. Unofficial fork; not affiliated with the Nicotine+ team.",
    "resources": {
      "../../sidecar/dist/seek-sidecar": "sidecar"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNkFFNEJFNTA3RDBDRDEKUldUUkRIMVF2dVJxYm9zelpiOVJqN2RROW5kcWl5T0pzNDd0bFdnTWtxUGNZNnZKWVlxV2M3UUwK",
      "endpoints": [
        "https://github.com/IvaKap/seek/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
